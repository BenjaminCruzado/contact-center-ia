# Aplicación
APP_NAME=Contact Center API
APP_VERSION=0.7.0
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000

# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000

# Proveedor de embeddings: local u openai
EMBEDDING_PROVIDER=local

# Embeddings locales
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=16
SENTENCE_TRANSFORMERS_HOME=/models/sentence-transformers

# OpenAI opcional (no subir credenciales reales)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# LLM del orquestador: mock, ollama u openai
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
OLLAMA_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_MODEL=llama3.1

# Login y roles del frontend
AUTH_SECRET_KEY=contact-center-dev-secret
AUTH_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
NORMAL_USERNAME=usuario
NORMAL_PASSWORD=user123

# Umbrales del orquestador
RAG_MIN_SIMILARITY=0.45
RAG_MIN_RESULTS=1
RAG_DEFAULT_CHUNK_SIZE=900
RAG_DEFAULT_CHUNK_OVERLAP=180
RAG_CONTEXT_TOP_K=5

# Voz
STT_PROVIDER=local
TTS_PROVIDER=local
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=es
WHISPER_CACHE_DIR=/models/whisper
TTS_VOICE=es-la
AUDIO_MAX_FILE_SIZE_BYTES=12582912
AUDIO_OUTPUT_MIME_TYPE=audio/wav

# Auditoría
AUDIT_DB_PATH=data/audit.db
AUDIT_CONFIDENCE_THRESHOLD=0.45
AUDIT_HIGH_LATENCY_MS=3000
AUDIT_HISTORY_LIMIT=100

# ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_HOST_PORT=8001
CHROMA_COLLECTION_PREFIX=contact-center-documents
